# Define the number of levels in the pyramid
levels = 5

# Loop through each level to print the pyramid
for i in range(levels):
    # Calculate the number of spaces and asterisks for the current level
    spaces = &#x27; &#x27; * (levels - i - 1)
    asterisks = &#x27;*&#x27; * (2 * i + 1)
    # Print the spaces followed by asterisks
    print(spaces + asterisks)
