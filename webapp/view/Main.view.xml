<mvc:View
    controllerName="com.example.NewUI5App.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="mainPage" title="{i18n>appTitle}">
        <content>
            <SearchField search=".onSearch" placeholder="Search..." class="sapUiSmallMarginBottom"/>
            <Table id="mainTable" items="{/Products}" growing="true">
                <columns>
                    <Column><Text text="ID"/></Column>
                    <Column><Text text="ProductName"/></Column>
                    <Column><Text text="Category"/></Column>
                    <Column><Text text="Price"/></Column>
                    <Column><Text text="Stock"/></Column>
                    <Column><Text text="Status"/></Column>
                </columns>
                <items>
                    <ColumnListItem type="Navigation" press=".onItemPress">
                        <cells>
                            <Text text="{iD}"/>
                            <Text text="{productName}"/>
                            <Text text="{category}"/>
                            <Text text="{price}"/>
                            <Text text="{stock}"/>
                            <Text text="{status}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
