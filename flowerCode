  entity SpareParts as projection on aerospace.SpareParts;
  entity AircraftConfiguration as projection on aerospace.AircraftConfiguration;
  entity SalesOrders as projection on aerospace.SalesOrders;
  entity ExportCompliance as projection on aerospace.ExportCompliance;
  entity SupplierAvailability as projection on aerospace.SupplierAvailability;
  entity OrderStatus as projection on aerospace.OrderStatus;

  action validatePartAvailability(partID: UUID) returns Array of SpareParts;
  action retrieveAircraftConfig(aircraftID: UUID) returns AircraftConfiguration;
  action verifyExportCompliance(partID: UUID) returns ExportCompliance;
  action validateMaintenanceSchedule(aircraftID: UUID) returns Boolean;
  action checkSupplierAvailability(supplierID: UUID, partID: UUID) returns SupplierAvailability;
}
```

